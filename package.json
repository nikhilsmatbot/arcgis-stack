{
  "name": "arcgis-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Pincode search + routing demo: Express proxy for ArcGIS REST services, Vite + TypeScript client with ArcGIS Maps SDK.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@arcgis/core": "4.29.10",
    "dotenv": "^17.2.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
