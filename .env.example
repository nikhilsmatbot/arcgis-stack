# Copy to .env and fill in. Never commit .env.

# Server-only API key for geocoding and routing. Never sent to the browser.
# ArcGIS: API key credentials, privileges Geocoding + Routing, no referrer restriction.
ARCGIS_API_KEY=

# OAuth 2.0 credentials for app authentication (basemap).
# The server exchanges these for a short-lived token (2 hours) and only that
# token goes to the browser. ArcGIS: OAuth 2.0 credentials -> "For app
# authentication", privilege Basemaps only.
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=

# Optional. Token endpoint base. Default: https://www.arcgis.com/sharing/rest
# ARCGIS_PORTAL_URL=

# Express port (default 3001).
PORT=3001
